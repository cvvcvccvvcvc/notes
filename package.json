{
  "name": "life-notes",
  "version": "0.6.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "preview": "npm run build && tsx scripts/local-preview.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "tsx --test lib/*.test.ts lib/sync/*.test.ts src/server/*.test.ts",
    "password:hash": "tsx src/server/hash-password.ts",
    "lint": "oxlint app components features hooks lib scripts src public/service-worker.js",
    "format": "oxfmt app components features hooks lib scripts src public/service-worker.js vite.config.ts",
    "format:check": "oxfmt --check app components features hooks lib scripts src public/service-worker.js vite.config.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "type": "module"
}
